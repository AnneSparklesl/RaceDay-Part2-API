@model List<RaceDay.Web.ViewModels.EventItemViewModel>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My events</h1>
    <a asp-action="Create" class="btn btn-primary">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">You have not created any events yet.</p>
            <a asp-action="Create" class="btn btn-primary">Create your first event</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Venue</th>
                            <th>Distance</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@item.Name</div>
                                    <span class="badge bg-secondary">@item.EventType</span>
                                </td>
                                <td>@item.EventDate.ToString("dd MMM yyyy, HH:mm")</td>
                                <td>@item.Venue</td>
                                <td>@item.DistanceKm.ToString("0.##") km</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                              onsubmit="return confirm('Delete this event?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
