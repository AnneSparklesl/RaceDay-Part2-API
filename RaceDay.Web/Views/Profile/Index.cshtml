@model RaceDay.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
    var initial = string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim().Substring(0, 1).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h1 class="mb-4">My profile</h1>

        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar avatar-lg">
                        @if (!string.IsNullOrWhiteSpace(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="Profile picture" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div>
                        <div class="h5 mb-0">@Model.Name</div>
                        <div class="text-muted small">
                            @Model.Role
                            @if (Model.CreatedAt.HasValue)
                            {
                                <span>&middot; Member since @Model.CreatedAt.Value.ToString("dd MMM yyyy")</span>
                            }
                        </div>
                    </div>
                </div>

                <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="mt-3">
                    <label class="form-label" for="picture">Profile picture</label>
                    <div class="input-group">
                        <input type="file" id="picture" name="picture" class="form-control" accept="image/*" required />
                        <button type="submit" class="btn btn-outline-primary">Upload</button>
                    </div>
                    <div class="form-text">JPG, PNG, GIF or WEBP, up to 2 MB.</div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2 class="h5 mb-3">Personal information</h2>
                <form method="post" asp-action="Index">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Full name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}