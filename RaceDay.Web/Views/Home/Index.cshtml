@model RaceDay.Web.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home";
}

@if (!Model.LoggedIn)
{
    <section class="hero text-center">
        <h1>Find your next <span>finish line</span></h1>
        <p class="lead mb-4">Discover runs, walks and cycling events, enter in a few clicks and track every result.</p>
        <a class="btn btn-primary btn-lg me-2" asp-controller="Account" asp-action="Register">Join RaceDay</a>
        <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
    </section>
}
else
{
    <h1 class="mb-1">Upcoming events</h1>
    <p class="text-muted mb-4">Find your next race, walk or ride.</p>

    <form method="get" asp-action="Index" class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="search">Search</label>
                    <input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Event name or keyword" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="type">Event type</label>
                    <select class="form-select" id="type" name="type">
                        <option value="">All types</option>
                        @foreach (var eventType in new[] { "Run", "Walk", "Cycle" })
                        {
                            <option value="@eventType" selected="@(Model.Type == eventType)">@eventType</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="venueId">Venue</label>
                    <select class="form-select" id="venueId" name="venueId">
                        <option value="">All venues</option>
                        @foreach (var venue in Model.Venues)
                        {
                            <option value="@venue.Id" selected="@(Model.VenueId == venue.Id)">@venue.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
            @if (Model.HasFilters)
            {
                <a asp-action="Index" class="small d-inline-block mt-2">Clear filters</a>
            }
        </div>
    </form>

    @if (!Model.Events.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <p class="text-muted mb-0">No upcoming events match your search.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Events)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card event-card h-100">
                        <div class="event-banner"><span>@item.EventType</span></div>
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5">@item.Name</h2>
                            <div class="text-muted small mb-2">@item.EventDate.ToString("ddd, dd MMM yyyy 'at' HH:mm")</div>
                            <div class="mb-2">
                                <span class="badge bg-secondary">@item.EventType</span>
                                <span class="badge bg-light text-dark border">@item.DistanceKm.ToString("0.##") km</span>
                            </div>
                            <div class="small mb-3">@item.Venue</div>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary mt-auto">View event</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}